#!/usr/bin/env sh
# SPDX-License-Identifier: AGPL-3.0-or-later

set -eu

if [ -n "${NIX_TERMUX_LIBEXEC:-}" ]; then
	libexec=$NIX_TERMUX_LIBEXEC
else
	script=$0
	case $script in
	*/*)
		;;
	*)
		script=$(command -v "$script" 2>/dev/null || printf '%s\n' "$script")
		;;
	esac
	script_dir=$(CDPATH='' cd -- "$(dirname -- "$script")" && pwd)
	if [ -r "$script_dir/../share/nix-termux/runtime/nix-termux.sh" ]; then
		libexec=$script_dir/../share/nix-termux/runtime
	else
		libexec=$script_dir/../runtime
	fi
fi

main=$libexec/nix-termux.sh
if [ ! -r "$main" ]; then
	printf '%s\n' "nix-termux: runtime not found at $main" >&2
	exit 127
fi

exec sh "$main" "$@"
