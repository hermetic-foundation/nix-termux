{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/midischwarz12/nix-termux/bootstrap/manifest.schema.json",
  "title": "nix-termux bootstrap manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "archive",
    "layout"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "termuxArch",
        "nixSystem"
      ],
      "properties": {
        "termuxArch": {
          "type": "string",
          "enum": [
            "aarch64",
            "arm",
            "i686",
            "x86_64"
          ]
        },
        "nixSystem": {
          "type": "string",
          "enum": [
            "aarch64-linux",
            "armv7l-linux",
            "i686-linux",
            "x86_64-linux"
          ]
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storeDir",
        "rootDir",
        "nixBin"
      ],
      "properties": {
        "storeDir": {
          "type": "string",
          "const": "nix"
        },
        "rootDir": {
          "type": "string",
          "const": "root"
        },
        "nixBin": {
          "type": "string",
          "const": "nix/var/nix/profiles/default/bin/nix"
        },
        "registration": {
          "type": "string",
          "const": "nix-termux/bootstrap.registration"
        }
      }
    }
  }
}
